//
// Phase 2 of the pest→lalrpop migration. See issue.md.
//
// Initial subset scope: core expressions, simple `val` decls,
// arithmetic/logical/comparison operators, function application,
// `if`/`let`, tuples, lists, parens. NOT yet covered (preserved
// in `/tmp/morel.full.lalrpop.draft` for incremental Phase 4
// expansion): full pattern grammar, fun/datatype/sig decls,
// relational queries (from/exists/forall), records, type
// annotations, `case`/`fn`, `over`.
//
// All binary precedence levels use lalrpop's `*` macro on the
// tail. Explicit `Empty | Recursive` rules surfaced LR(1)
// conflicts that the macro form resolves cleanly (Phase 0 spike
// proved this works for the iterative pattern).

use std::rc::Rc;
use crate::syntax::ast::{
    Decl, DeclKind, Expr, ExprKind, Label, LabeledExpr, Literal,
    LiteralKind, Match, Pat, PatKind, Statement, StatementKind,
    Type, TypeKind, ValBind,
};
use crate::syntax::lalr_parser::{
    mk_add, mk_comp, mk_cons, mk_mult, mk_span,
};
use crate::syntax::lexer::{Tok, LexError};

grammar<'input>(input: &'input Rc<str>);

extern {
    type Location = usize;
    type Error = LexError;

    enum Tok {
        // Keywords (subset)
        "andalso"   => Tok::AndAlso,
        "as"        => Tok::As,
        "case"      => Tok::Case,
        "div"       => Tok::Div,
        "elem"      => Tok::Elem,
        "else"      => Tok::Else,
        "end"       => Tok::End,
        "fn"        => Tok::Fn,
        "if"        => Tok::If,
        "in"        => Tok::In,
        "let"       => Tok::Let,
        "mod"       => Tok::Mod,
        "notelem"   => Tok::NotElem,
        "o"         => Tok::O,
        "of"        => Tok::Of,
        "orelse"    => Tok::OrElse,
        "rec"       => Tok::Rec,
        "then"      => Tok::Then,
        "val"       => Tok::Val,
        "with"      => Tok::With,
        "true"      => Tok::True,
        "false"     => Tok::False,

        // Punctuation
        "=>"   => Tok::FatArrow,
        "->"   => Tok::Arrow,
        "::"   => Tok::DoubleColon,
        ":"    => Tok::Colon,
        "<="   => Tok::Le,
        ">="   => Tok::Ge,
        "<>"   => Tok::Ne,
        "("    => Tok::LParen,
        ")"    => Tok::RParen,
        "["    => Tok::LBracket,
        "]"    => Tok::RBracket,
        "{"    => Tok::LBrace,
        "}"    => Tok::RBrace,
        ","    => Tok::Comma,
        ";"    => Tok::Semicolon,
        "|"    => Tok::Pipe,
        "~"    => Tok::Tilde,
        "_"    => Tok::Underscore,
        "="    => Tok::Eq,
        "<"    => Tok::Lt,
        ">"    => Tok::Gt,
        "@"    => Tok::At,
        "+"    => Tok::Plus,
        "-"    => Tok::Minus,
        "^"    => Tok::Caret,
        "*"    => Tok::Star,
        "/"    => Tok::Slash,

        // Content
        IDENT       => Tok::Ident(<String>),
        TY_VAR      => Tok::TyVar(<String>),
        INT_LIT     => Tok::IntLit(<String>),
        REAL_LIT    => Tok::RealLit(<String>),
        SCI_LIT     => Tok::SciLit(<String>),
        STRING_LIT  => Tok::StringLit(<String>),
        CHAR_LIT    => Tok::CharLit(<String>),
    }
}

// =================================================================
// Entry points
// =================================================================

pub StatementSemi: Statement = <s:Statement> ";" => s;

pub Statement: Statement = {
    <l:@L> <e:Expr> <r:@R> => Statement {
        kind: StatementKind::Expr(e.kind.clone()),
        span: mk_span(&input, l, r),
        id: None,
    },
    <l:@L> <d:Decl> <r:@R> => Statement {
        kind: StatementKind::Decl(d.kind.clone()),
        span: mk_span(&input, l, r),
        id: None,
    },
};

// =================================================================
// Expressions
// =================================================================

// `if` and `let` live at the top level only, not inside Atom. SML
// follows the same convention because in LR(1), placing them at
// Atom-level creates a dangling-else ambiguity with the application
// rule: `if a then b else c d` could parse as either
// `if a then b else (c d)` or `(if a then b else c) d`, and one-token
// lookahead can't disambiguate. To use a `let`/`if` as a function
// argument, parenthesize it: `f (let val x = 1 in x end)`. Morel-pest
// allowed both via PEG greedy matching.
Expr: Expr = {
    AnnotExpr,
    IfExpr,
    LetExpr,
    CaseExpr,
    FnExpr,
};

// `<expr> : <type>` at the very top of the precedence cascade
// (morel.pest:169 `expr_annotated`). Annotation is optional; bare
// expression skips it.
//
// Step 3 restriction: the annotation type is `AtomicType` only.
// Compound types (fn types, tuple types, applied types) must be
// parenthesized: `(x : (int -> int))`. This isolates the type
// cascade from FOLLOW(Expr) pollution that otherwise creates
// shift-reduce conflicts in TupleType (`*` chain) and ApplyType
// (IDENT chain). morel.pest allows compound types without parens
// because PEG is greedy; LR(1) needs the boundary.
AnnotExpr: Expr = {
    OrElseExpr,
    <e:OrElseExpr> ":" <t:AtomicType> => {
        let span = e.span.union(&t.span);
        ExprKind::Annotated(Box::new(e), Box::new(t)).spanned(&span)
    },
};

OrElseExpr: Expr = {
    <h:AndAlsoExpr> <r:("orelse" <AndAlsoExpr>)*> => {
        r.into_iter().fold(h, |a, b| {
            let span = a.span.union(&b.span);
            ExprKind::OrElse(Box::new(a), Box::new(b)).spanned(&span)
        })
    },
};

AndAlsoExpr: Expr = {
    <h:CompExpr> <r:("andalso" <CompExpr>)*> => {
        r.into_iter().fold(h, |a, b| {
            let span = a.span.union(&b.span);
            ExprKind::AndAlso(Box::new(a), Box::new(b)).spanned(&span)
        })
    },
};

CompExpr: Expr = {
    <h:ConsExpr> <r:(<CompOp> <ConsExpr>)*> => {
        r.into_iter().fold(h, |a, (op, b)| {
            let span = a.span.union(&b.span);
            mk_comp(op, a, b).spanned(&span)
        })
    },
};

CompOp: &'static str = {
    "="       => "=",
    "<>"      => "<>",
    "<="      => "<=",
    ">="      => ">=",
    "<"       => "<",
    ">"       => ">",
    "elem"    => "elem",
    "notelem" => "notelem",
};

// `::` and `@` right-associative — collect left-to-right then fold
// from the right.
ConsExpr: Expr = {
    <h:AddExpr> <r:(<ConsOp> <AddExpr>)*> => {
        if r.is_empty() {
            h
        } else {
            let mut head = h;
            let mut acc: Vec<(&'static str, Expr)> = Vec::new();
            for (op, b) in r {
                acc.insert(0, (op, head));
                head = b;
            }
            acc.into_iter().fold(head, |right, (op, left)| {
                let span = left.span.union(&right.span);
                mk_cons(op, left, right).spanned(&span)
            })
        }
    },
};

ConsOp: &'static str = { "::" => "::", "@" => "@", };

AddExpr: Expr = {
    <h:MultExpr> <r:(<AddOp> <MultExpr>)*> => {
        r.into_iter().fold(h, |a, (op, b)| {
            let span = a.span.union(&b.span);
            mk_add(op, a, b).spanned(&span)
        })
    },
};

AddOp: &'static str = { "+" => "+", "-" => "-", "^" => "^", };

MultExpr: Expr = {
    <h:ApplExpr> <r:(<MultOp> <ApplExpr>)*> => {
        r.into_iter().fold(h, |a, (op, b)| {
            let span = a.span.union(&b.span);
            mk_mult(op, a, b).spanned(&span)
        })
    },
};

MultOp: &'static str = {
    "*"   => "*",
    "/"   => "/",
    "div" => "div",
    "mod" => "mod",
};

// Function application: `f x y` ≡ `Apply(Apply(f, x), y)`.
ApplExpr: Expr = {
    UnaryExpr,
    <h:ApplExpr> <a:Atom> => {
        let span = h.span.union(&a.span);
        ExprKind::Apply(Box::new(h), Box::new(a)).spanned(&span)
    },
};

UnaryExpr: Expr = {
    Atom,
    <l:@L> "~" <e:UnaryExpr> <r:@R> => {
        ExprKind::Negate(Box::new(e)).spanned(&mk_span(&input, l, r))
    },
};

Atom: Expr = {
    LiteralExpr,
    <l:@L> <i:IDENT> <r:@R> => {
        ExprKind::Identifier(i).spanned(&mk_span(&input, l, r))
    },
    TupleOrParen,
    ListExpr,
    RecordExpr,
};

LiteralExpr: Expr = {
    <l:@L> <s:INT_LIT> <r:@R> => {
        let sp = mk_span(&input, l, r);
        ExprKind::Literal(LiteralKind::Int(s).spanned(&sp)).spanned(&sp)
    },
    <l:@L> <s:REAL_LIT> <r:@R> => {
        let sp = mk_span(&input, l, r);
        ExprKind::Literal(LiteralKind::Real(s).spanned(&sp)).spanned(&sp)
    },
    <l:@L> <s:SCI_LIT> <r:@R> => {
        let sp = mk_span(&input, l, r);
        ExprKind::Literal(LiteralKind::Real(s).spanned(&sp)).spanned(&sp)
    },
    <l:@L> <s:STRING_LIT> <r:@R> => {
        let sp = mk_span(&input, l, r);
        ExprKind::Literal(LiteralKind::String(s).spanned(&sp)).spanned(&sp)
    },
    <l:@L> <s:CHAR_LIT> <r:@R> => {
        let sp = mk_span(&input, l, r);
        ExprKind::Literal(LiteralKind::Char(s).spanned(&sp)).spanned(&sp)
    },
    <l:@L> "true" <r:@R> => {
        let sp = mk_span(&input, l, r);
        ExprKind::Literal(LiteralKind::Bool(true).spanned(&sp)).spanned(&sp)
    },
    <l:@L> "false" <r:@R> => {
        let sp = mk_span(&input, l, r);
        ExprKind::Literal(LiteralKind::Bool(false).spanned(&sp)).spanned(&sp)
    },
};

TupleOrParen: Expr = {
    <l:@L> "(" ")" <r:@R> => {
        let sp = mk_span(&input, l, r);
        ExprKind::Literal(LiteralKind::Unit.spanned(&sp)).spanned(&sp)
    },
    <l:@L> "(" <h:Expr> <t:("," <Expr>)*> ")" <r:@R> => {
        if t.is_empty() {
            h
        } else {
            let mut v = vec![h]; v.extend(t);
            ExprKind::Tuple(v).spanned(&mk_span(&input, l, r))
        }
    },
};

ListExpr: Expr = {
    <l:@L> "[" "]" <r:@R> => {
        ExprKind::List(vec![]).spanned(&mk_span(&input, l, r))
    },
    <l:@L> "[" <h:Expr> <t:("," <Expr>)*> "]" <r:@R> => {
        let mut v = vec![h]; v.extend(t);
        ExprKind::List(v).spanned(&mk_span(&input, l, r))
    },
};

// `if`/`let` bodies use MatchBody (no top-level case/fn) for the
// same reason MatchP does — so that a nested `case`/`fn` inside an
// `else` or `in` clause must be parenthesized, preventing a
// dangling-`|` ambiguity with an enclosing match.
IfExpr: Expr = {
    <l:@L> "if" <c:Expr> "then" <t:Expr> "else" <e:MatchBody> <r:@R> => {
        ExprKind::If(Box::new(c), Box::new(t), Box::new(e))
            .spanned(&mk_span(&input, l, r))
    },
};

LetExpr: Expr = {
    <l:@L> "let" <h:Decl> <t:(";"? <Decl>)*> ";"? "in" <e:MatchBody> "end" <r:@R> => {
        let mut decls = vec![h]; decls.extend(t);
        ExprKind::Let(decls, Box::new(e)).spanned(&mk_span(&input, l, r))
    },
};

CaseExpr: Expr = {
    <l:@L> "case" <e:Expr> "of" <ms:MatchList> <r:@R> => {
        ExprKind::Case(Box::new(e), ms).spanned(&mk_span(&input, l, r))
    },
};

FnExpr: Expr = {
    <l:@L> "fn" <ms:MatchList> <r:@R> => {
        ExprKind::Fn(ms).spanned(&mk_span(&input, l, r))
    },
};

MatchList: Vec<Match> = {
    <h:MatchP> <t:("|" <MatchP>)*> => {
        let mut v = vec![h]; v.extend(t); v
    },
};

// The match body uses a RESTRICTED expression form that doesn't end
// with an unparenthesized `case`/`fn`. Otherwise `fn p => fn q => 1 |
// p2 => 2` is genuinely ambiguous: does `| p2 => 2` belong to the
// inner or outer fn's MatchList? PEG goes greedy (inner); LR(1)
// can't decide. Standard ML resolves the same way as us — nested
// case/fn need parens. The body still allows `if`/`let` (no `|`
// terminator) and the full precedence cascade.
MatchP: Match = {
    <p:Pat> "=>" <e:MatchBody> => Match { pat: p, expr: e },
};

MatchBody: Expr = {
    AnnotExpr,
    IfExpr,
    LetExpr,
};

// `{}` or `{ label = expr, label = expr, ... }`.
//
// Step 1 limitation: dropping the morel.pest record-body shorthands
// {`anonymous field` for `name = name`, and `{e with ...}` for
// copy-and-update). Both reintroduce an IDENT-vs-label LR(1)
// ambiguity at `{ IDENT`: lookahead `=` would say "label" but a
// regular expression like `IDENT = ...` is also valid (where `=` is
// a comparison). pest resolves with PEG ordered choice; lalrpop
// would need restructuring or external lookahead. Phase 3 step 6
// brings these back.
RecordExpr: Expr = {
    <l:@L> "{" "}" <r:@R> => {
        ExprKind::Record(None, vec![]).spanned(&mk_span(&input, l, r))
    },
    <l:@L> "{" <h:LabeledExprP> <t:("," <LabeledExprP>)*> "}" <r:@R> => {
        let mut v = vec![h]; v.extend(t);
        ExprKind::Record(None, v).spanned(&mk_span(&input, l, r))
    },
};

LabeledExprP: LabeledExpr = {
    <l:@L> <name:IDENT> <r:@R> "=" <e:Expr> => {
        LabeledExpr::new(
            Some(Label::new(&name, &mk_span(&input, l, r))),
            &e,
        )
    },
};

// =================================================================
// Declarations (subset: val only)
// =================================================================

Decl: Decl = ValDecl;

ValDecl: Decl = {
    <l:@L> "val" <rc:"rec"?> <p:Pat> "=" <e:Expr> <r:@R> => {
        let vb = ValBind::of(&p, None, &e);
        DeclKind::Val(rc.is_some(), false, vec![vb])
            .spanned(&mk_span(&input, l, r))
    },
};

// =================================================================
// Patterns
// =================================================================

// Step 3 narrowing: pattern annotations (`pat : type`) deferred.
// They expose Type to FOLLOW(Pat), which interacts badly with the
// already-fragile type cascade. Add back when types are robust.
Pat: Pat = ConsPat;

// `::` right-associative — collect with iterative tail then fold from
// the right (mirrors the expression-level ConsExpr).
ConsPat: Pat = {
    <h:AlmostAtomicPat> <r:("::" <AlmostAtomicPat>)*> => {
        if r.is_empty() {
            h
        } else {
            let mut head = h;
            let mut acc: Vec<Pat> = Vec::new();
            for b in r {
                acc.insert(0, head);
                head = b;
            }
            acc.into_iter().fold(head, |right, left| {
                let span = left.span.union(&right.span);
                PatKind::Cons(Box::new(left), Box::new(right)).spanned(&span)
            })
        }
    },
};

// Step 3 narrowed scope: drop ConstructorPat, ListPat, RecordPat for
// now. These each interact with FOLLOW-set pollution from ApplExpr,
// ListExpr, RecordExpr (shared tokens) and lalrpop's LALR-merge.
// Phase 3 later steps reintroduce them.
AlmostAtomicPat: Pat = AtomicPat;

AtomicPat: Pat = {
    <l:@L> "_" <r:@R> => PatKind::Wildcard.spanned(&mk_span(&input, l, r)),
    <l:@L> <name:IDENT> "as" <p:AtomicPat> <r:@R> => {
        PatKind::As(name, Box::new(p)).spanned(&mk_span(&input, l, r))
    },
    <l:@L> <i:IDENT> <r:@R> => {
        PatKind::Identifier(i).spanned(&mk_span(&input, l, r))
    },
    <l:@L> <lit:PatLiteral> <r:@R> => {
        let sp = mk_span(&input, l, r);
        PatKind::Literal(lit.kind.spanned(&sp)).spanned(&sp)
    },
    TuplePat,
};

TuplePat: Pat = {
    <l:@L> "(" ")" <r:@R> => {
        PatKind::Tuple(vec![]).spanned(&mk_span(&input, l, r))
    },
    <l:@L> "(" <h:Pat> <t:("," <Pat>)*> ")" <r:@R> => {
        if t.is_empty() {
            h
        } else {
            let mut v = vec![h]; v.extend(t);
            PatKind::Tuple(v).spanned(&mk_span(&input, l, r))
        }
    },
};

// Pattern-only literal (avoids a circular dep with the expression
// LiteralExpr rule).

// =================================================================
// Types (Phase 3 step 2 subset: id, type-var, parens, app, tuple, fn)
// =================================================================
//
// Deferred to step 6: record types, `typeof` expression types, and
// composite parameter lists `(int, string) bar`.

Type: Type = FnType;

FnType: Type = {
    TupleType,
    <l:TupleType> "->" <r:FnType> => {
        let span = l.span.union(&r.span);
        TypeKind::Fn(Box::new(l), Box::new(r)).spanned(&span)
    },
};

TupleType: Type = {
    <h:ApplyType> <r:("*" <ApplyType>)*> => {
        if r.is_empty() {
            h
        } else {
            let mut span = h.span.clone();
            let mut all = vec![h];
            for t in r { span = span.union(&t.span); all.push(t); }
            TypeKind::Tuple(all).spanned(&span)
        }
    },
};

// `int list`, `'a list`, `'a stack` — left-associative application.
ApplyType: Type = {
    <h:AtomicType> <r:NamedTypeApp*> => {
        r.into_iter().fold(h, |arg, name| {
            let span = arg.span.union(&name.span);
            TypeKind::App(vec![arg], Box::new(name)).spanned(&span)
        })
    },
};

NamedTypeApp: Type = {
    <l:@L> <i:IDENT> <r:@R> => {
        TypeKind::Id(i).spanned(&mk_span(&input, l, r))
    },
};

AtomicType: Type = {
    <l:@L> <i:IDENT> <r:@R> => {
        TypeKind::Id(i).spanned(&mk_span(&input, l, r))
    },
    <l:@L> <v:TY_VAR> <r:@R> => {
        TypeKind::Var(v).spanned(&mk_span(&input, l, r))
    },
    "(" <t:Type> ")" => t,
};

// Pattern-only literal (avoids a circular dep with the expression
// LiteralExpr rule).
PatLiteral: Literal = {
    <l:@L> <s:INT_LIT> <r:@R> => LiteralKind::Int(s).spanned(&mk_span(&input, l, r)),
    <l:@L> <s:REAL_LIT> <r:@R> => LiteralKind::Real(s).spanned(&mk_span(&input, l, r)),
    <l:@L> <s:SCI_LIT> <r:@R> => LiteralKind::Real(s).spanned(&mk_span(&input, l, r)),
    <l:@L> <s:STRING_LIT> <r:@R> => LiteralKind::String(s).spanned(&mk_span(&input, l, r)),
    <l:@L> <s:CHAR_LIT> <r:@R> => LiteralKind::Char(s).spanned(&mk_span(&input, l, r)),
    <l:@L> "true" <r:@R> => LiteralKind::Bool(true).spanned(&mk_span(&input, l, r)),
    <l:@L> "false" <r:@R> => LiteralKind::Bool(false).spanned(&mk_span(&input, l, r)),
};
