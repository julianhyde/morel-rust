 * Conformance suite for the relational tree.
 *
 * A placeholder. morel-java's suite of the same name is the
 * cross-implementation contract, and replaces this file at milestone
 * R6 of plan.md. Until then it holds what the parts already built can
 * be held to.
 *)

(* A plan is longer than the default `stringDepth`, which would
 * truncate it. morel-java's suite sets the same. *)
Sys.set ("stringDepth", ~1);
> val it = () : unit

(* A query prints as a relational tree, one node per line, with the
 * collection type of each node. The binder `i` is gone, and the filter
 * reads the element as `$0`. This is morel-java's first case, and its
 * text, byte for byte. *)
Sys.planOf (from i in [1, 2, 3] where i > 1);
> val it = {_|
> filter [$0 > 1] : int list
>   [1, 2, 3] : int list
> |_} : string

(* A query with several binders ends in a projection that names its
 * element's components: the tree holds no names, so this is where the
 * ones the query wrote come back. *)
Sys.planOf (from i in [1, 2], j in [3, 4] where i < j yield {i, j});
> val it =
>   {_|
> project [{i = #1 $0, j = #2 $0}] : {i:int, j:int} list
>   filter [#1 $0 < #2 $0] : (int * int) list
>     join : (int * int) list
>       [1, 2] : int list
>       [3, 4] : int list
> |_} : string

(* A join concatenates its inputs' components and carries no yield;
 * the projection above it is where the components are named. The
 * filter's line does not fit, so it folds before the `andalso`, four
 * from the node. This is morel-java's text byte for byte. *)
Sys.set ("lineWidth", 78);
> val it = () : unit
useSilently "scott.smli";
> [opening scott.smli]
> val it = () : unit
Sys.planOf (
  from d in scott.depts, e in scott.emps
    where e.deptno = d.deptno andalso e.job = "PRESIDENT"
    yield {dname = d.dname, ename = e.ename});
> val it =
>   {_|
> project [{dname = #dname (#1 $0), ename = #ename (#2 $0)}] : t$0
>   filter [#deptno (#2 $0) = #deptno (#1 $0)
>       andalso #job (#2 $0) = "PRESIDENT"] : t$1
>     join : t$1
>       #depts scott : t$2
>       #emps scott : t$3
>
> t$0 {dname:string, ename:string} bag
> t$1 ({deptno:int, dname:string, loc:string} * {comm:real, deptno:int, empno:int, ename:string, hiredate:string, job:string, mgr:int, sal:real}) bag
> t$2 {deptno:int, dname:string, loc:string} bag
> t$3 {comm:real, deptno:int, empno:int, ename:string, hiredate:string, job:string, mgr:int, sal:real} bag
> |_} : string

(* Three inputs. The joins nest to the left and the components stay
 * flat, read as `#1`, `#2`, `#3`; the record's fields fold after each
 * comma. *)
Sys.planOf (
  from d in scott.depts, e in scott.emps, b in scott.bonuses
    where e.deptno = d.deptno andalso b.ename = e.ename
    yield {d.dname, e.ename, b.comm});
> val it =
>   {_|
> project [{comm = #comm (#3 $0),
>     dname = #dname (#1 $0),
>     ename = #ename (#2 $0)}] : t$0
>   filter [#deptno (#2 $0) = #deptno (#1 $0)
>       andalso #ename (#3 $0) = #ename (#2 $0)] : t$1
>     join : t$1
>       join : t$2
>         #depts scott : t$3
>         #emps scott : t$4
>       #bonuses scott : t$5
>
> t$0 {comm:real, dname:string, ename:string} bag
> t$1 ({deptno:int, dname:string, loc:string} * {comm:real, deptno:int, empno:int, ename:string, hiredate:string, job:string, mgr:int, sal:real} * {comm:real, ename:string, job:string, sal:real}) bag
> t$2 ({deptno:int, dname:string, loc:string} * {comm:real, deptno:int, empno:int, ename:string, hiredate:string, job:string, mgr:int, sal:real}) bag
> t$3 {deptno:int, dname:string, loc:string} bag
> t$4 {comm:real, deptno:int, empno:int, ename:string, hiredate:string, job:string, mgr:int, sal:real} bag
> t$5 {comm:real, ename:string, job:string, sal:real} bag
> |_} : string

(* An outer join wraps each component of the side that may be absent
 * in `option`, on its own rather than the row as a whole. The
 * condition still sees both sides present, as `$0` and `$1`, whatever
 * the kind. Run it too: the OPERATIONS row, which has no employee, is
 * what the wrapping is for. This is morel-java's text byte for byte. *)
from d in scott.depts
  left join e in scott.emps on e.deptno = d.deptno
  yield {d.dname, who = e?.ename};
> val it =
>   [{dname="ACCOUNTING",who=SOME "CLARK"},
>    {dname="ACCOUNTING",who=SOME "KING"},
>    {dname="ACCOUNTING",who=SOME "MILLER"},
>    {dname="RESEARCH",who=SOME "SMITH"},{dname="RESEARCH",who=SOME "JONES"},
>    {dname="RESEARCH",who=SOME "SCOTT"},{dname="RESEARCH",who=SOME "ADAMS"},
>    {dname="RESEARCH",who=SOME "FORD"},{dname="SALES",who=SOME "ALLEN"},
>    {dname="SALES",who=SOME "WARD"},{dname="SALES",who=SOME "MARTIN"},
>    {dname="SALES",who=SOME "BLAKE"},{dname="SALES",who=SOME "TURNER"},
>    {dname="SALES",who=SOME "JAMES"},{dname="OPERATIONS",who=NONE}]
>   : {dname:string, who:string option} bag
Sys.planOf (
  from d in scott.depts
    left join e in scott.emps on e.deptno = d.deptno
    yield {d.dname, who = e?.ename});
> val it =
>   {_|
> project [{dname = #dname (#1 $0), who = #map Option #ename (#2 $0)}] : t$0
>   join [left] [#deptno $1 = #deptno $0] : t$1
>     #depts scott : t$2
>     #emps scott : t$3
>
> t$0 {dname:string, who:string option} bag
> t$1 ({deptno:int, dname:string, loc:string} * {comm:real, deptno:int, empno:int, ename:string, hiredate:string, job:string, mgr:int, sal:real} option) bag
> t$2 {deptno:int, dname:string, loc:string} bag
> t$3 {comm:real, deptno:int, empno:int, ename:string, hiredate:string, job:string, mgr:int, sal:real} bag
> |_} : string

(* A right join makes the left side's components optional instead. *)
Sys.planOf (
  from d in scott.depts
    right join e in scott.emps on e.deptno = d.deptno
    yield {who = e.ename});
> val it =
>   {_|
> project [{who = #ename (#2 $0)}] : {who:string} bag
>   join [right] [#deptno $1 = #deptno $0] : t$0
>     #depts scott : t$1
>     #emps scott : t$2
>
> t$0 ({deptno:int, dname:string, loc:string} option * {comm:real, deptno:int, empno:int, ename:string, hiredate:string, job:string, mgr:int, sal:real}) bag
> t$1 {deptno:int, dname:string, loc:string} bag
> t$2 {comm:real, deptno:int, empno:int, ename:string, hiredate:string, job:string, mgr:int, sal:real} bag
> |_} : string

(* A full join makes both sides optional. *)
Sys.planOf (
  from d in scott.depts
    full join e in scott.emps on e.deptno = d.deptno
    yield {who = e?.ename});
> val it =
>   {_|
> project [{who = #map Option #ename (#2 $0)}] : {who:string option} bag
>   join [full] [#deptno $1 = #deptno $0] : t$0
>     #depts scott : t$1
>     #emps scott : t$2
>
> t$0 ({deptno:int, dname:string, loc:string} option * {comm:real, deptno:int, empno:int, ename:string, hiredate:string, job:string, mgr:int, sal:real} option) bag
> t$1 {deptno:int, dname:string, loc:string} bag
> t$2 {comm:real, deptno:int, empno:int, ename:string, hiredate:string, job:string, mgr:int, sal:real} bag
> |_} : string

(* `group` builds a record of its keys and aggregates, and the names
 * the query wrote are read back off it. The tree, the types and the
 * legend are morel-java's; the aggregates are not, and plan.md's
 * findings say why. *)
Sys.planOf (
  from e in scott.emps
    group {e.deptno}
    compute {c = count over (), total = sum over e.sal});
> val it =
>   {_|
> group [deptno = #deptno $0] [c = (#count Relational over ()), total = (sum$real over #sal $0)] : t$0
>   #emps scott : t$1
>
> t$0 {c:int, deptno:int, total:real} bag
> t$1 {comm:real, deptno:int, empno:int, ename:string, hiredate:string, job:string, mgr:int, sal:real} bag
> |_} : string

(* Where the translator declines -- it does not guess -- the plan is
 * the step list that runs the query. A `group` is one such. *)
Sys.planOf (from i in [1, 2] group j = i);
> val it = "from i in [1, 2] group i yield i" : string

(* `e` is not evaluated. `List.hd []` raises `Empty`, and a plan of it
 * does not. *)
List.hd [];
> uncaught exception Empty
>   raised at: stdIn:1.1-1.11
Sys.planOf (List.hd []);
> val it = "#hd List ([])" : string

(* Applied to an expression is the only way it can work: used as a
 * value, the expression is gone by the time it runs and only the
 * value remains. *)
List.map Sys.planOf [1];
> val it = ["Sys.planOf must be applied to an expression"] : string list

(*) End rel-tree.smli
