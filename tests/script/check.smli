(* This file is being brought over from morel-java a section at a time; it
 * will hold that file's contents when the last of them works here. *)

(* --- A claim on a composite is a claim about its components ----- *)

type nat = int check i => i >= 0;
> type nat = int check i => i >= 0

(* A vector is walked element by element, as a list is. It is not a
 * collection -- a query cannot scan one -- and it is an eqtype, so it has no
 * constructors to walk either; before this it fell between the two, and a
 * condition inside one was claimed and never checked. *)
type natVector = nat vector;
> type natVector = nat vector
val vs: natVector = Vector.fromList [1, 2];
> val vs = #[1,2] : natVector
val vs2: natVector = Vector.fromList [1, ~2];
> uncaught exception Constraint [~2 is not a valid nat: [_]]
>   raised at: stdIn:1.5-1.45
val vs3: nat vector list = [Vector.fromList [~1]];
> uncaught exception Constraint [~1 is not a valid nat: [_][_]]
>   raised at: stdIn:1.5-1.50

(*) An annotation on a component of a pattern claims that component.
val (compA: nat, compB) = (~1, 2);
> uncaught exception Constraint [~1 is not a valid nat: component 1]
>   raised at: stdIn:1.5-1.34
fun compFn (x: nat, y: int) = x;
> val compFn = fn : nat * int -> nat
compFn (~1, 2);
> uncaught exception Constraint [~1 is not a valid nat: component 1]
>   raised at: stdIn:1.5-1.32

(* A record pattern claims per field, as a tuple pattern claims per
 * component. A field the pattern does not mention claims nothing. *)
val {x = fieldX: nat, y = fieldY} = {x = ~1, y = 2};
> uncaught exception Constraint [~1 is not a valid nat: field x]
>   raised at: stdIn:1.5-1.52
fun fieldFn {x: nat, y: int} = x;
> val fieldFn = fn : {x:nat, y:int} -> nat
fieldFn {x = ~1, y = 2};
> uncaught exception Constraint [~1 is not a valid nat: field x]
>   raised at: stdIn:1.5-1.33
fieldFn {x = 1, y = 2};
> val it = 1 : int
val {x = ellipsisX: nat, ...} = {x = ~1, y = 2};
> uncaught exception Constraint [~1 is not a valid nat: field x]
>   raised at: stdIn:1.5-1.48

(* A 'fun' declaration's result annotation reaches Resolver as an ascription
 * on the body, so a result is checked too. The declared type is still 'int':
 * the annotation and the body's type meet, and the meet of a checked type
 * and the type it abbreviates is the latter. What is at fault is the body,
 * not the whole declaration, so that is what a message blames. *)
fun neg () : nat = ~1;
> val neg = fn : unit -> int
neg ();
> uncaught exception Constraint [~1 is not a valid nat]
>   raised at: stdIn:1.20-1.22
fun pos () : nat = 1;
> val pos = fn : unit -> int
pos ();
> val it = 1 : int
fun idNat (x: int) : nat = x;
> val idNat = fn : int -> int
idNat 1;
> val it = 1 : int
idNat ~1;
> uncaught exception Constraint [~1 is not a valid nat]
>   raised at: stdIn:1.28

(* --- 'typeof' names the type it was shown, conditions and all --- *)

(* 'typeof e' names the type 'e' was shown to have, conditions and all, so an
 * annotation that uses it claims what that type claims. *)
val n: nat = 5;
> val n = 5 : nat
val fromTypeof: typeof n = 5;
> val fromTypeof = 5 : nat
val fromTypeofBad: typeof n = ~5;
> uncaught exception Constraint [~5 is not a valid nat]
>   raised at: stdIn:1.5-1.33
(~5 : typeof n);
> uncaught exception Constraint [~5 is not a valid nat]
>   raised at: stdIn:1.1-1.16

(*) The same, where what the expression claims has no name.
val bounded = 5 check i => i < 100;
> val bounded = 5 : int check i => i < 100
val boundedOk: typeof bounded = 7;
> val boundedOk = 7 : int check i => i < 100
val boundedHigh: typeof bounded = 200;
> uncaught exception Constraint [200 is not a valid value]
>   raised at: stdIn:1.5-1.38

(* A condition written on a 'typeof' is not supported. A condition is typed
 * against its base, and the base has to be materialized to do that, which a
 * 'typeof' cannot be at the point a type is converted. A 'typeof' in a type
 * or datatype declaration does work, because there the expression it names
 * can be deduced on its own. *)
(5 : (typeof n check i => i < 100));
> stdIn:1.7-1.15 Error: 'typeof' is not supported here
>   raised at: stdIn:1.7-1.15

(* A condition written on an expression whose type carries conditions
 * already claims both. Without them the claim would be the weaker one, and
 * a value that fails only the type's own condition would be let through.
 *
 * TODO morel-java writes the type 'positive check i => i < 100', naming
 * the type the conditions came from; here the conditions are stacked and
 * the name is not kept. What is claimed is the same. *)
type positive = int check i => i >= 1;
> type positive = int check i => i >= 1
val one: positive = 1;
> val one = 1 : positive
val bounded = one check i => i < 100;
> val bounded = 1 : int check i => i >= 1 check i => i < 100
val boundedOk: typeof bounded = 7;
> val boundedOk = 7 : int check i => i >= 1 check i => i < 100
val boundedLow: typeof bounded = 0;
> uncaught exception Constraint [0 is not a valid value]
>   raised at: stdIn:1.5-1.35
val boundedHigh: typeof bounded = 200;
> uncaught exception Constraint [200 is not a valid value]
>   raised at: stdIn:1.5-1.38

(* --- Conditions on types that are not named --------------------- *)

(* A type may carry a condition wherever it is written, not only where it is
 * declared, so a constraint can sit on the thing it is about. *)
type point = {x: int check i => i >= 0, y: int check i => i >= 0};
> type point = {x:int check i => i >= 0, y:int check i => i >= 0}
val p1: point = {x = 1, y = 2};
> val p1 = {x=1,y=2} : point
val p2: point = {x = 1, y = ~2};
> uncaught exception Constraint [~2 is not a valid value: field y]
>   raised at: stdIn:1.5-1.32

(* A type that is not named is called "value" in a message. It has no name to
 * give, and printing its condition would repeat what the message already says
 * failed; the blame path says which value it was. *)

(* A condition binds more loosely than anything else in a type, so it applies
 * to the whole type: here the condition is given the pair, not the second
 * component. *)
type wholePair = int * int check c => #1 c >= 0;
> type wholePair = int * int check c => #1 c >= 0
val wp: wholePair = (~1, 2);
> uncaught exception Constraint [(~1,2) is not a valid wholePair]
>   raised at: stdIn:1.5-1.28

(*) Parenthesizing puts the condition on a component instead.
type partPair = (int check c => c >= 0) * int;
> type partPair = (int check c => c >= 0) * int
val pp2: partPair = (~1, 2);
> uncaught exception Constraint [~1 is not a valid value: component 1]
>   raised at: stdIn:1.5-1.28

(* --- A condition that reaches through a datatype ---------------- *)

(* A schema is a record of collections, and its condition may follow a
 * datatype into another of them: every picture must refer to a row that
 * exists. *)
type emp = {empno: int, ename: string};
> type emp = {empno:int, ename:string}
type product = {sku: string, name: string};
> type product = {name:string, sku:string}
datatype ref = EMP of int | PRODUCT of string;
> datatype ref = EMP of int | PRODUCT of string
type picture = {ref: ref, bytes: word vector};
> type picture = {bytes:word vector, ref:ref}

type schema = {
  emps: emp bag,
  products: product bag,
  pictures: picture bag
}
check s =>
  forall p in s.pictures
    require case p.ref of
      EMP (empno) => (exists e in s.emps where e.empno = empno)
    | PRODUCT (sku) => exists p in s.products where p.sku = sku;
> type schema = {emps:emp bag, pictures:picture bag, products:product bag} check s => forall p in #pictures s require case #ref p of EMP empno => exists e in #emps s where #empno e = empno | PRODUCT sku => exists p in #products s where #sku p = sku

(*) A schema whose every picture refers to a row that exists.
val s0: schema = {
  emps = bag [{empno = 1, ename = "Fred"}],
  products = bag [{sku = "A1", name = "Anvil"}],
  pictures = bag [{ref = EMP 1, bytes = Vector.fromList [0w1]},
                  {ref = PRODUCT "A1", bytes = Vector.fromList [0w2]}]};
> val s0 =
>   {emps=[{empno=1,ename="Fred"}],
>    pictures=[{bytes=#[0wx1],ref=EMP 1},{bytes=#[0wx2],ref=PRODUCT "A1"}],
>    products=[{name="Anvil",sku="A1"}]} : schema

(*) Adding a picture that refers to nothing breaks it.
val sBadEmp: schema = {s0 replace pictures = from p in s0.pictures
  union [{ref = EMP 99, bytes = Vector.fromList [0w3]}]};
> uncaught exception Constraint [{emps=[{empno=1,ename="Fred"}],pictures=[{bytes=#[0wx1],ref=EMP 1},{bytes=#[0wx2],ref=PRODUCT "A1"},{bytes=#[0wx3],ref=EMP 99}],products=[{name="Anvil",sku="A1"}]} is not a valid schema]
>   raised at: stdIn:1.23-2.57
val sBadProduct: schema = {s0 replace pictures = from p in s0.pictures
  union [{ref = PRODUCT "Z9", bytes = Vector.fromList [0w4]}]};
> uncaught exception Constraint [{emps=[{empno=1,ename="Fred"}],pictures=[{bytes=#[0wx1],ref=EMP 1},{bytes=#[0wx2],ref=PRODUCT "A1"},{bytes=#[0wx4],ref=PRODUCT "Z9"}],products=[{name="Anvil",sku="A1"}]} is not a valid schema]
>   raised at: stdIn:1.27-2.63

(*) Deleting the employee breaks it from the other side.
val sNoEmp: schema = {s0 replace emps = from e in s0.emps where e.empno <> 1};
> uncaught exception Constraint [{emps=[],pictures=[{bytes=#[0wx1],ref=EMP 1},{bytes=#[0wx2],ref=PRODUCT "A1"}],products=[{name="Anvil",sku="A1"}]} is not a valid schema]
>   raised at: stdIn:1.22-1.78

(* --- A modifier inherits the record's own condition ------------- *)

(* A modifier that changes the record's shape cannot claim its type, but the
 * type's own conditions need not be lost with the name. A condition is
 * carried over if every field it depends on was left alone, and rewritten to
 * name them as the result names them. The result is a checked type that
 * has no name. *)
type crate = {a: int, b: nat} check r => r.a < 10;
> type crate = {a:int, b:nat} check r => #a r < 10
val v0: crate = {a = 1, b = 2};
> val v0 = {a=1,b=2} : crate

(*) 'extend' leaves every field alone, so every condition is carried over.
{v0 extend c = 5};
> val it = {a=1,b=2,c=5} : {a:int, b:nat, c:int} check r => #a r < 10

(* 'remove' drops a condition that mentions the field it removed -- the
 * condition would no longer typecheck -- and keeps one that does not.
 * Projecting a column away drops the constraints that mention it, as it does
 * in a database. *)
{v0 remove a};
> val it = {b=2} : {b:nat}
{v0 remove b};
> val it = {a=1} : {a:int} check r => #a r < 10

(* TODO 'rename' should carry the condition over with the field renamed
 * inside it: morel-java gives '{b:nat, z:int} check r => #z r < 10'.
 * Rewriting the condition needs the written form walked, which is not done
 * yet, so it is dropped, which claims less. *)
{v0 rename z = a};
> val it = {b=2,z=1} : {b:nat, z:int}

(* The condition is carried into the type, not just displayed on it, so it is
 * enforced where the derived record is modified again. This is what the
 * inheritance is for: a schema derived by 'extend' keeps its invariants. *)
val v1 = {v0 extend c = 5};
> val v1 = {a=1,b=2,c=5} : {a:int, b:nat, c:int} check r => #a r < 10
{v1 replace a = 3};
> val it = {a=3,b=2,c=5} : {a:int, b:nat, c:int} check r => #a r < 10
{v1 replace a = 20};
> uncaught exception Constraint [{a=20,b=2,c=5} is not a valid value]
>   raised at: stdIn:1.1-1.20

(* A condition that depends on a field the modifier assigned to is dropped:
 * the value that is there now was never shown to satisfy it. *)
{v0 replace a = 3 extend c = 1};
> val it = {a=3,b=2,c=1} : {a:int, b:nat, c:int}
{v0 replace b = 3 extend c = 1};
> val it = {a=1,b=3,c=1} : {a:int, b:int, c:int} check r => #a r < 10

(* A condition is compiled once and carried from statement to statement, so
 * it selects a field by its slot. A field that a modifier moved -- because
 * the modifier added one that sorts before it -- would need the compiled
 * form rewritten, so the condition is dropped rather than left selecting
 * the wrong field. *)
type shifted = {b: int, c: int} check r => r.b < 10;
> type shifted = {b:int, c:int} check r => #b r < 10
val s0: shifted = {b = 1, c = 2};
> val s0 = {b=1,c=2} : shifted
val s1 = {s0 extend a = 0};
> val s1 = {a=0,b=1,c=2} : {a:int, b:int, c:int}
{s1 replace b = 20};
> val it = {a=0,b=20,c=2} : {a:int, b:int, c:int}

(* A condition written by destructuring is rewritten to select instead, so
 * that it holds of a record with fields its pattern does not mention.
 * Otherwise whether a condition could be inherited would depend on how it
 * happened to be written. *)
type parity = {i: int, j: int} check {i, j} => i mod 2 = j mod 2;
> type parity = {i:int, j:int} check {i = i, j = j} => i mod 2 = j mod 2
val p0: parity = {i = 2, j = 4};
> val p0 = {i=2,j=4} : parity
val p1 = {p0 extend k = 1};
> val p1 = {i=2,j=4,k=1}
>   : {i:int, j:int,
>       k:int} check $r => let val i = #i $r and j = #j $r in i mod 2 = j mod 2 end
{p1 replace i = 4};
> val it = {i=4,j=4,k=1}
>   : {i:int, j:int,
>       k:int} check $r => let val i = #i $r and j = #j $r in i mod 2 = j mod 2 end
{p1 replace i = 3};
> uncaught exception Constraint [{i=3,j=4,k=1} is not a valid value]
>   raised at: stdIn:1.1-1.19

(* A condition that uses the record as a whole, rather than by selecting
 * fields from it, is dropped: a record of another shape is not that record. *)
type whole = {i: int, j: int} check r => r = {i = 1, j = 2};
> type whole = {i:int, j:int} check r => r = {i = 1, j = 2}
val w0: whole = {i = 1, j = 2};
> val w0 = {i=1,j=2} : whole
{w0 extend k = 9};
> val it = {i=1,j=2,k=9} : {i:int, j:int, k:int}

(* --- A condition on an expression ------------------------------- *)

(* 'e check m' adds a condition to the type deduced for e: the counterpart of
 * 'as' for a type that is not named. It checks, and the binding carries the
 * type. *)
val y = 1;
> val y = 1 : int
val small = y + 1 check i => i < 100;
> val small = 2 : int check i => i < 100
val big = y + 1 check i => i < 2;
> uncaught exception Constraint [2 is not a valid value]
>   raised at: stdIn:1.11-1.33
val nonEmpty = "ab" check s => String.size s > 1;
> val nonEmpty = "ab" : string check s => #size String s > 1

(*) Arithmetic drops it, as it drops a named one: the meet is the body.
val sum = small + 1;
> val sum = 3 : int

(* The same rule means an expression-level condition inside a match must be
 * parenthesized, since otherwise the match would have ended. *)
val guarded = (fn i => (i check j => j > 0)) 3;
> val guarded = 3 : int
val guardedBad = (fn i => (i check j => j > 0)) ~3;
> uncaught exception Constraint [~3 is not a valid value]
>   raised at: stdIn:1.27-1.47

(* Several conditions belong to one expression, as they do to one type
 * declaration. Nesting them would put each in the type of the last, and only
 * the last would be seen. *)
val twiceChecked = y + 1 check i => i > 0 check i => i < 100;
> val twiceChecked = 2 : int check i => i > 0 check i => i < 100
val failsFirst = y + 1 check i => i > 5 check i => i < 100;
> uncaught exception Constraint [2 is not a valid value]
>   raised at: stdIn:1.18-1.59

(* A condition binds more loosely than anything else in a type, so it is
 * parenthesized wherever it is not the whole type. *)
fun keepSmall (n: (int check i => i < 100)) = n;
> val keepSmall = fn : (int check i => i < 100) -> (int check i => i < 100)

(* A match ends where a 'check' begins, which is what lets a type carry
 * several conditions: the first condition here ends at the second 'check'
 * rather than swallowing it. *)
type twice = int check i => i >= 1 check j => j <= 12;
> type twice = int check i => i >= 1 check j => j <= 12
val six: twice = 6;
> val six = 6 : twice
val thirteen: twice = 13;
> uncaught exception Constraint [13 is not a valid twice]
>   raised at: stdIn:1.5-1.25

(* A condition may be written wherever a type is written, not only where a
 * type is declared: in an annotation, or on a parameter. Parentheses are
 * needed, because a condition extends as far right as it can and would
 * otherwise swallow what follows. *)
(*) morel-java gives 'val direct = [1] : int list'.
val direct: (int check i => i >= 0) list = [1];
> val direct = [1] : (int check i => i >= 0) list
val notNat: (int check i => i >= 0) = ~1;
> uncaught exception Constraint [~1 is not a valid value]
>   raised at: stdIn:1.5-1.41
fun mustBeNat (n: (int check i => i >= 0)) = n;
> val mustBeNat = fn : (int check i => i >= 0) -> (int check i => i >= 0)
mustBeNat 3;
> val it = 3 : int
mustBeNat ~3;
> uncaught exception Constraint [~3 is not a valid value]
>   raised at: stdIn:1.5-1.47

(* --- Shadowing, which has to come last -------------------------- *)

(* Whether a reference is to the basis is decided by the binding, not by the
 * name. A user who shadows a basis name has declared a value of their own,
 * and a condition that referred to it would take its meaning from the
 * environment: before this was checked, the condition below was accepted, and
 * admitted ~1 though it reads as "not negative".
 *
 * This shadows 'not' for everything after it, so it comes last. *)
val not = fn (b: bool) => true;
> val not = fn : bool -> bool
not false;
> val it = true : bool
type shadowed = int check i => not (i < 0);
> stdIn:1.1-1.20 Error: condition of checked type 'shadowed' is not closed; it refers to 'not'
>   raised at: stdIn:1.1-1.20

(*) End check.smli
