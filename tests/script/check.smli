(* This file is being brought over from morel-java a section at a time; it
 * will hold that file's contents when the last of them works here. *)

(* --- A modifier inherits the record's own condition ------------- *)

(* A modifier that changes the record's shape cannot claim its type, but the
 * type's own conditions need not be lost with the name. A condition is
 * carried over if every field it depends on was left alone, and rewritten to
 * name them as the result names them. The result is a checked type that
 * has no name. *)
type nat = int check i => i >= 0;
> type nat = int check i => i >= 0
type crate = {a: int, b: nat} check r => r.a < 10;
> type crate = {a:int, b:nat} check r => #a r < 10
val v0: crate = {a = 1, b = 2};
> val v0 = {a=1,b=2} : crate

(*) 'extend' leaves every field alone, so every condition is carried over.
{v0 extend c = 5};
> val it = {a=1,b=2,c=5} : {a:int, b:nat, c:int} check r => #a r < 10

(* 'remove' drops a condition that mentions the field it removed -- the
 * condition would no longer typecheck -- and keeps one that does not.
 * Projecting a column away drops the constraints that mention it, as it does
 * in a database. *)
{v0 remove a};
> val it = {b=2} : {b:nat}
{v0 remove b};
> val it = {a=1} : {a:int} check r => #a r < 10

(* TODO 'rename' should carry the condition over with the field renamed
 * inside it: morel-java gives '{b:nat, z:int} check r => #z r < 10'.
 * Rewriting the condition needs the written form walked, which is not done
 * yet, so it is dropped, which claims less. *)
{v0 rename z = a};
> val it = {b=2,z=1} : {b:nat, z:int}

(* The condition is carried into the type, not just displayed on it, so it is
 * enforced where the derived record is modified again. This is what the
 * inheritance is for: a schema derived by 'extend' keeps its invariants. *)
val v1 = {v0 extend c = 5};
> val v1 = {a=1,b=2,c=5} : {a:int, b:nat, c:int} check r => #a r < 10
{v1 replace a = 3};
> val it = {a=3,b=2,c=5} : {a:int, b:nat, c:int} check r => #a r < 10
{v1 replace a = 20};
> uncaught exception Constraint [{a=20,b=2,c=5} is not a valid value]
>   raised at: stdIn:1.1-1.20

(* A condition that depends on a field the modifier assigned to is dropped:
 * the value that is there now was never shown to satisfy it. *)
{v0 replace a = 3 extend c = 1};
> val it = {a=3,b=2,c=1} : {a:int, b:nat, c:int}
{v0 replace b = 3 extend c = 1};
> val it = {a=1,b=3,c=1} : {a:int, b:int, c:int} check r => #a r < 10

(* A condition is compiled once and carried from statement to statement, so
 * it selects a field by its slot. A field that a modifier moved -- because
 * the modifier added one that sorts before it -- would need the compiled
 * form rewritten, so the condition is dropped rather than left selecting
 * the wrong field. *)
type shifted = {b: int, c: int} check r => r.b < 10;
> type shifted = {b:int, c:int} check r => #b r < 10
val s0: shifted = {b = 1, c = 2};
> val s0 = {b=1,c=2} : shifted
val s1 = {s0 extend a = 0};
> val s1 = {a=0,b=1,c=2} : {a:int, b:int, c:int}
{s1 replace b = 20};
> val it = {a=0,b=20,c=2} : {a:int, b:int, c:int}

(* TODO A condition written by destructuring should be rewritten to select
 * instead, so that it holds of a record with fields its pattern does not
 * mention: morel-java gives '$r => let val i = #i $r and j = #j $r in
 * i mod 2 = j mod 2 end'. That rewrite needs the written form walked too. *)
type parity = {i: int, j: int} check {i, j} => i mod 2 = j mod 2;
> type parity = {i:int, j:int} check {i = i, j = j} => i mod 2 = j mod 2
val p0: parity = {i = 2, j = 4};
> val p0 = {i=2,j=4} : parity
val p1 = {p0 extend k = 1};
> val p1 = {i=2,j=4,k=1} : {i:int, j:int, k:int}
{p1 replace i = 4};
> val it = {i=4,j=4,k=1} : {i:int, j:int, k:int}
{p1 replace i = 3};
> val it = {i=3,j=4,k=1} : {i:int, j:int, k:int}

(* A condition that uses the record as a whole, rather than by selecting
 * fields from it, is dropped: a record of another shape is not that record. *)
type whole = {i: int, j: int} check r => r = {i = 1, j = 2};
> type whole = {i:int, j:int} check r => r = {i = 1, j = 2}
val w0: whole = {i = 1, j = 2};
> val w0 = {i=1,j=2} : whole
{w0 extend k = 9};
> val it = {i=1,j=2,k=9} : {i:int, j:int, k:int}

(* --- A condition on an expression ------------------------------- *)

(* 'e check m' adds a condition to the type deduced for e: the counterpart of
 * 'as' for a type that is not named. It checks, and the binding carries the
 * type. *)
val y = 1;
> val y = 1 : int
(* TODO The condition should reach the binding: morel-java gives
 * 'val small = 2 : int check i => i < 100'. The type a term carries loses
 * a nameless alias where an expression is annotated, though a named one
 * survives, so the condition is checked but not displayed. *)
val small = y + 1 check i => i < 100;
> val small = 2 : int
val big = y + 1 check i => i < 2;
> uncaught exception Constraint [2 is not a valid value]
>   raised at: stdIn:1.11-1.33
val nonEmpty = "ab" check s => String.size s > 1;
> val nonEmpty = "ab" : string

(*) Arithmetic drops it, as it drops a named one: the meet is the body.
val sum = small + 1;
> val sum = 3 : int

(* A condition binds more loosely than anything else in a type, so it is
 * parenthesized wherever it is not the whole type. *)
fun keepSmall (n: (int check i => i < 100)) = n;
> val keepSmall = fn : (int check i => i < 100) -> (int check i => i < 100)

(* A match ends where a 'check' begins, which is what lets a type carry
 * several conditions: the first condition here ends at the second 'check'
 * rather than swallowing it. *)
type twice = int check i => i >= 1 check j => j <= 12;
> type twice = int check i => i >= 1 check j => j <= 12
val six: twice = 6;
> val six = 6 : twice
val thirteen: twice = 13;
> uncaught exception Constraint [13 is not a valid twice]
>   raised at: stdIn:1.5-1.25

(* A condition may be written wherever a type is written, not only where a
 * type is declared: in an annotation, or on a parameter. Parentheses are
 * needed, because a condition extends as far right as it can and would
 * otherwise swallow what follows. *)
(*) morel-java gives 'val direct = [1] : int list'.
val direct: (int check i => i >= 0) list = [1];
> val direct = [1] : (int check i => i >= 0) list
val notNat: (int check i => i >= 0) = ~1;
> uncaught exception Constraint [~1 is not a valid value]
>   raised at: stdIn:1.5-1.41
fun mustBeNat (n: (int check i => i >= 0)) = n;
> val mustBeNat = fn : (int check i => i >= 0) -> (int check i => i >= 0)
mustBeNat 3;
> val it = 3 : int
mustBeNat ~3;
> uncaught exception Constraint [~3 is not a valid value]
>   raised at: stdIn:1.5-1.47

(*) End check.smli
