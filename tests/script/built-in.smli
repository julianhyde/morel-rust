Sys.plan ();
> val it =
>   "apply2(fnValue +, constant(2), apply2(fnValue Int.times, constant(3), constant(4)))"
>   : string
14 div 3;
> val it = 4 : int
14 div ~3;
> val it = ~5 : int

from (i, j) in [(14, 3), (~14, 3), (14, ~3), (~14, ~3)]
 where (i div j) <> Int.`div` (i, j)
 orelse (i mod j) <> Int.`mod` (i, j);
> val it = [] : {i:int, j:int} list
fn x => x + 1;
> val it = fn : int -> int
Sys.plan ();
> val it = "fn(bind(0) => apply2(fnValue +, get(0), constant(1)))" : string

(* Create a "not a number" value whose sign bit is true. IEEE does not specify
   whether the sign bit of NaN values should be set. It is useful to
   "standardize" behavior for this particular value, for the duration of this
   test, to behave similarly to negative numbers. Otherwise subsequent tests
   will give different results on different hardware. *)
val nan =
  let
     val n = Real.posInf / Real.posInf
  in
     if Real.signBit n then n else ~n
 end;
> val nan = nan : real
Real.signBit nan;
> val it = true : bool

