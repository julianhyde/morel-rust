(* Simple tail recursion ------------------------------------------
 * resum: a simple tail-recursive accumulator.
 * Needs TCO to handle large inputs (depth > ~1,000).
 *)
let
  fun resum (m, n) =
    if m = 0 then n
    else resum (m - 1, n + 1)
in
  resum (1000, 0)
end;
> val it = 1000 : int

let fun resum (m, n) = if m = 0 then n else resum (m - 1, n + 1)
in resum (1000000, 0) end;
> val it = 1000000 : int

(* Coprime numbers -------------------------------------------------------
 * coprime: tests whether two numbers are coprime.
 * a and b are coprime if their greatest common divisor is 1.
 * Uses mutual tail recursion.
 *)
fun coprime (a, b) =
  if a < 1 orelse b < 1 then false
  else if a = 1 orelse b = 1 then true
  else if a < b then coprime (a, b mod a)
  else if a > b then coprime (a mod b, b)
  else false;
> val coprime = fn : int * int -> bool

coprime (3, 2);
> val it = true : bool

coprime (6, 1);
> val it = true : bool

coprime (1, 8);
> val it = true : bool

coprime (~6, 2);
> val it = false : bool

coprime (15, 3);
> val it = false : bool

coprime (15, 6);
> val it = false : bool

coprime (6, 15);
> val it = false : bool

coprime (21, 10);
> val it = true : bool

(*) the 46th and 45th terms in the fibonacci sequence
coprime (1836311903, 1134903170);
> val it = true : bool

(* Closure-capture regression: an inner fn whose `bound_vars` count +
 * `local_vars` count happens to equal the enclosing function's frame
 * size used to take a wrong "recursive re-entry" shortcut in
 * `capture_bound_vals` (the heuristic compared frame size, not
 * frame-def identity) and bind captured values to the wrong slot
 * positions. The body of `inner` here uses `b` first, then `a`, so
 * inner's `bound_vars` order is `[b, a]` while the outer slot order
 * is `[a, b, inner]`; the buggy shortcut fed `[a_val, b_val]` into
 * `[b, a]` and inner returned the wrong branch. Fixed by tracking
 * frame_def identity in [`Frame`]. *)
fun outer (a, b) =
  let
    fun inner x = if x then b else a
  in
    inner true
  end;
> val outer = fn : 'a * 'a -> 'a

outer (10, 20);
> val it = 20 : int

(* The N-queens block from morel-java commit 6bf5306c (#148) is
 * deferred. It exposes a separate, pre-existing issue: a
 * closure-bound recursive `fun` (here: `try`, defined inside
 * `addQueen`'s let) is referenced via the `LinkTable` from a
 * deeper nested closure (`fn () => try (j + 1)`), and
 * `Code::Link` resolves to the `Code::CreateClosure` for `try`
 * which then captures from the *current* frame (the inner
 * fn's), not the let-binder's (`addQueen`'s). The standard fix
 * is to capture closure-bound recursive fns lexically (with
 * cyclic-Arc initialisation for the self-slot) instead of
 * routing them through the link table. That is a structural
 * refactor of `Val::Closure` and is left as a follow-up. *)

(*) End tail-recursion.smli
