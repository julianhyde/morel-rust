 *
 * Phase 2 of the Datalog port (hydromatic/morel#323): exercises
 * `Datalog.validate` only. Phases 3 and 4 will add `translate` and
 * `execute` cases here.
 *)
Sys.set ("lineWidth", 78);
> val it = () : unit
Sys.set ("printLength", 999);
> val it = () : unit
Sys.set ("stringDepth", ~1);
> val it = () : unit

Datalog;
> val it = {validate=fn} : {validate:string -> string}

(*) Valid program: returns "OK" (provisional; phase 4 will return a
(*) type description).
Datalog.validate ".decl edge(x:int, y:int)\nedge(1,2).";
> val it = "OK" : string

(*) Schema validation - arity mismatch in fact.
Datalog.validate ".decl edge(x:int, y:int)\nedge(1,2,3).";
> val it = "Compilation error: Atom edge/3 does not match declaration edge/2"
>   : string

(*) Schema validation - undeclared relation in fact.
Datalog.validate ".decl edge(x:int, y:int)\npath(1,2).";
> val it = "Compilation error: Relation 'path' used in fact but not declared"
>   : string

(*) Schema validation - type mismatch in fact.
Datalog.validate ".decl edge(x:int, y:int)\nedge(\"a\", 2).";
> val it =
>   "Compilation error: Type mismatch in fact edge(...): expected int, got string for parameter x"
>   : string

(*) Safety - unsafe rule (variable in head not in body).
Datalog.validate ".decl edge(x:int, y:int)\n.decl path(x:int, y:int)\npath(X,Y) :- edge(X,Z).";
> val it =
>   "Compilation error: Rule is unsafe. Variable 'Y' in head does not appear in positive body atom"
>   : string

(*) Stratification - negation cycle.
Datalog.validate ".decl p(x:int)\n.decl q(x:int)\np(X) :- q(X).\nq(X) :- !p(X), p(X).";
> val it =
>   "Compilation error: Program is not stratified. Negation cycle detected involving relation: p"
>   : string

(*) Positive self-recursion is OK (transitive closure).
Datalog.validate ".decl edge(x:int, y:int)\n.decl path(x:int, y:int)\npath(X,Y) :- edge(X,Y).\npath(X,Z) :- path(X,Y), edge(Y,Z).";
> val it = "OK" : string

(*) Method-style call also works.
".decl edge(x:int, y:int)\nedge(1,2).".validate ();
> val it = "OK" : string

(*) End built-in/datalog.smli
