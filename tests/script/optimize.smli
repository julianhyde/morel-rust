 *
 * Tests for inlining and other optimizations.
 *)
Sys.set ("stringDepth", ~1);
> val it = () : unit

(*) === Variable inlining ===

(*) A variable used once is inlined.
let val x = 1 in x + 2 end;
> val it = 3 : int
Sys.plan ();
> val it = "apply2(fnValue +, constant(1), constant(2))" : string

(*) A variable used twice is not inlined if non-atomic.
let val x = 1 + 1 in x + x end;
> val it = 4 : int
Sys.plan ();
> val it =
>   "let(bind(bind(0) = apply2(fnValue +, constant(1), constant(1))) in apply2(fnValue +, get(0), get(0)))"
>   : string

(*) An atomic variable (bound to a literal) used twice is inlined.
let val x = 5 in x + x end;
> val it = 10 : int
Sys.plan ();
> val it = "apply2(fnValue +, constant(5), constant(5))" : string

(*) A dead variable (not used) is removed.
let val x = 1 val y = 2 in y end;
> val it = 2 : int
Sys.plan ();
> val it = "constant(2)" : string

(*) === Function inlining ===

(*) A function applied once is not yet inlined in morel-rust; it remains
(*) wrapped in a `let` and an immediate application.
let val f = fn x => x + 1 in f 5 end;
> val it = 6 : int
Sys.planEx "0";
> val it = "val it = let val f = fn x => op + (x, 1) in f 5 end" : string

(*) === Singleton case inlining ===

(*) A singleton case with id pattern is not yet substituted in morel-rust.
let val f = fn x => case x of y => y + 2 in f 3 end;
> val it = 5 : int
Sys.planEx "0";
> val it =
>   "val it = let val f = fn x => case x of y => op + (y, 2) in f 3 end"
>   : string

(*) === Constant case inlining (issue hydromatic/morel#330) ===

(*) Case on a constant matching a literal pattern.
let val x = 2 in case x of 1 => "one" | 2 => "two" | _ => "large" end;
> val it = "two" : string
Sys.plan ();
> val it = "constant(two)" : string

(*) Case on a constant matching the first pattern.
let val x = 1 in case x of 1 => "one" | 2 => "two" | _ => "large" end;
> val it = "one" : string
Sys.plan ();
> val it = "constant(one)" : string

(*) Case on a constant matching the wildcard pattern.
let val x = 99 in case x of 1 => "one" | 2 => "two" | _ => "large" end;
> val it = "large" : string
Sys.plan ();
> val it = "constant(large)" : string

(*) Case on a constant with id pattern that binds the value. With only one
(*) match arm, the constant-case rewrite does not fire (matching morel-java
(*) behaviour); the case stays as-is in the plan.
let val x = 5 in case x of y => y + 10 end;
> val it = 15 : int
Sys.plan ();
> val it = "case(constant(5), bind(0), apply2(fnValue +, get(0), constant(10)))"
>   : string

(*) If-then-else with constant true condition.
if true then "yes" else "no";
> val it = "yes" : string
Sys.plan ();
> val it = "constant(yes)" : string

(*) If-then-else with constant false condition.
if false then "yes" else "no";
> val it = "no" : string
Sys.plan ();
> val it = "constant(no)" : string
Sys.planEx "~1";
> val it = "val it = case false of true => \"yes\" | _ => \"no\"" : string
Sys.planEx "0";
> val it = "val it = \"no\"" : string

(*) Boolean case.
let val b = true in case b of true => 1 | false => 0 end;
> val it = 1 : int
Sys.plan ();
> val it = "constant(1)" : string

(*) String case.
let val s = "hello" in case s of "hello" => 1 | "world" => 2 | _ => 3 end;
> val it = 1 : int
Sys.plan ();
> val it = "constant(1)" : string

(*) Char case.
let val c = #"a" in case c of #"a" => 1 | #"b" => 2 | _ => 3 end;
> val it = 1 : int
Sys.plan ();
> val it = "constant(1)" : string

(*) Real case.
let val r = 1.0 in case r of 0.0 => 0 | 1.0 => 1 | _ => 2 end;
> val it = 1 : int
Sys.planEx "0";
> val it = "val it = 1" : string

(*) Tuple case.
let
  val t = (1, "a")
in
  case t of
     (0, _) => "zero"
   | (1, s) => "one:" ^ s
   | _ => "other"
end;
> val it = "one:a" : string
Sys.planEx "~1";
> val it =
>   "val it = let val t = (1, \"a\") in case t of (0, _) => \"zero\" | (1, s) => op ^ (\"one:\", s) | _ => \"other\" end"
>   : string
Sys.planEx "0";
> val it = "val it = op ^ (\"one:\", \"a\")" : string

(*) Option case (an enum with one argument).
let
  val someA = SOME "a"
in
  case someA of
      SOME "0" => "some0"
    | SOME s => "some:" ^ s
    | NONE => "none"
end;
> val it = "some:a" : string
Sys.planEx "~1";
> val it =
>   "val it = let val someA = Option.SOME \"a\" in case someA of SOME \"0\" => \"some0\" | SOME s => op ^ (\"some:\", s) | NONE => \"none\" end"
>   : string
Sys.planEx "0";
> val it = "val it = op ^ (\"some:\", \"a\")" : string

let
  val none = NONE
in
  case none of
      SOME "0" => "some0"
    | SOME s => "some:" ^ s
    | NONE => "none"
end;
> val it = "none" : string
Sys.planEx "~1";
> val it =
>   "val it = let val none = NONE in case none of SOME \"0\" => \"some0\" | SOME s => op ^ (\"some:\", s) | NONE => \"none\" end"
>   : string
Sys.planEx "0";
> val it = "val it = \"none\"" : string

(*) Record, Either and user-defined datatype cases (e.g. `LESS`/`GREATER`,
(*) `INL`/`INR`, and `tree`-shaped datatypes) are present in the morel-java
(*) optimize.smli but are not yet exercised here. They depend on
(*) capabilities (datatype constructor matching in `Pat::bind_recurse`,
(*) record-pattern coverage analysis, and shared variable names across
(*) match arms) that morel-rust still lacks.

(*) End optimize.smli
