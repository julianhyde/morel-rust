fun my_map f [] = []
  | my_map f (x::xs) = (f x) :: (my_map f xs);
> val
fun double x = x * 2;
> val
map double [1, 2, 3, 4, 5];
> val
my_map (fn s => s ^ "!") ["hello", "world"];
> val
